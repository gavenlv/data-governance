<?xml version="1.0" encoding="UTF-8"?>
<!--
  通用数据治理平台 · 控制面（Java 21 + Spring Boot）

  模块划分对齐 docs/10-tech-stack.md §8 的仓库结构：
    dg-model      模型注册表（YAML 定义 → 校验 / 兼容性检查 / 生成类型）
    dg-core       元数据内核（真相源 / 版本 / 审计 / outbox 事件 / 派生视图）
    dg-ingestion  采集框架与连接器
    dg-lineage    血缘（SQL 解析侧车接入 + OpenLineage）
    dg-quality    数据质量与可观测性            ← 骨架，未实现（见 @Unimplemented）
    dg-policy     访问治理与策略                ← 骨架，未实现
    dg-ai         AI 原生能力                   ← 骨架，未实现
    dg-api        REST API 与装配（Spring Boot 应用）
    dg-sdk        客户端 SDK                    ← 骨架，未实现
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!--
          版本选择受 NFR-SEC-01（docs/23）约束：不用已停止安全维护的版本线。
          3.1.0（2023-05）带来的 Tomcat 10.1.8 / Spring Framework 6.0.9 / Security 6.1.0
          在 2026 年已积累 10 项 CRITICAL、42 项 HIGH（详见 docs/23 §7 的实测记录）。
        -->
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.datagovernance</groupId>
    <artifactId>dg-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>Data Governance Platform</name>
    <description>通用数据治理平台 · 控制面（Java 21 + Spring Boot 3）</description>

    <modules>
        <module>dg-model</module>
        <module>dg-core</module>
        <module>dg-ingestion</module>
        <module>dg-lineage</module>
        <module>dg-quality</module>
        <module>dg-policy</module>
        <module>dg-ai</module>
        <module>dg-api</module>
        <module>dg-sdk</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- springdoc 2.9.x 对应 Spring Boot 3.5；3.x 是给 Boot 4 的，不能混用 -->
        <springdoc.version>2.9.1</springdoc.version>
        <!--
          mongodb-driver-sync 显式固定版本：我们只直接用同步驱动（不走 spring-data-mongodb），
          因此由这里统一控制版本，避免随框架大版本被动跳变。
        -->
        <mongodb-driver.version>5.13.0</mongodb-driver.version>

        <!--
          ===== NFR-SEC-01（docs/23）：把框架托管的传递依赖提升到**已修复的补丁版本** =====

          Spring Boot 3.5.16 的依赖管理里，下列版本仍低于各自的修复版本（实测见 docs/23 §7）。
          框架补丁发布有节奏，而 CRITICAL 不等人，因此这里显式覆盖 —— 这是"先修漏洞再等框架"
          的标准做法，覆盖的全是同小版本的补丁号，风险可控。

            组件            框架托管    本处固定    修复的漏洞
            tomcat          10.1.55    10.1.60    GHSA-9xv2-5v5q-p794 / GHSA-gcx9-497g-6cp6 /
                                                 GHSA-h3x4-894j-xpx5（3 项 CRITICAL）
                                                 注：OSV 给的修复版本是 10.1.58，但 Maven Central 上
                                                 **没有发布 10.1.58**（10.1.57 之后直接是 10.1.59），
                                                 因此取 10.1.x 线最新补丁 10.1.60。
            jackson-bom      2.21.4     2.21.7    GHSA-7hhh-6rmp-j9qf / GHSA-p6pp-m3f8-5c89 /
                                                 GHSA-cxp5-3px4-pw24 / GHSA-q4xh-88c3-wmh7 /
                                                 GHSA-wv8q-qhhj-9h54（5 项 HIGH）+ 6 项 MEDIUM
            commons-lang3    3.17.0     3.18.0    GHSA-j288-q9x7-2f5v（MEDIUM，无界递归）
            log4j2           2.24.3     2.26.1    GHSA-qv9r-c865-cp47（MEDIUM，非有限浮点编码）

          这些覆盖项必须在每次升级 Spring Boot 后**重新核对**：
          一旦框架托管版本 ≥ 本处固定值，就删掉对应覆盖（避免长期钉住旧版本）。
          `tools/dependency_audit.py` 会持续给出证据。
        -->
        <tomcat.version>10.1.60</tomcat.version>
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <log4j2.version>2.26.1</log4j2.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.datagovernance</groupId>
                <artifactId>dg-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.datagovernance</groupId>
                <artifactId>dg-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.datagovernance</groupId>
                <artifactId>dg-ingestion</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.datagovernance</groupId>
                <artifactId>dg-lineage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.datagovernance</groupId>
                <artifactId>dg-quality</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.datagovernance</groupId>
                <artifactId>dg-policy</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.datagovernance</groupId>
                <artifactId>dg-ai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.datagovernance</groupId>
                <artifactId>dg-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
