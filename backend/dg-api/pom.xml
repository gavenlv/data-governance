<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.datagovernance</groupId>
        <artifactId>dg-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>dg-api</artifactId>
    <name>dg-api</name>
    <description>REST API 与装配（Spring Boot 应用入口）</description>

    <dependencies>
        <dependency>
            <groupId>com.datagovernance</groupId>
            <artifactId>dg-model</artifactId>
        </dependency>
        <dependency>
            <groupId>com.datagovernance</groupId>
            <artifactId>dg-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.datagovernance</groupId>
            <artifactId>dg-ingestion</artifactId>
        </dependency>
        <dependency>
            <groupId>com.datagovernance</groupId>
            <artifactId>dg-lineage</artifactId>
        </dependency>
        <dependency>
            <groupId>com.datagovernance</groupId>
            <artifactId>dg-quality</artifactId>
        </dependency>
        <dependency>
            <groupId>com.datagovernance</groupId>
            <artifactId>dg-policy</artifactId>
        </dependency>
        <dependency>
            <groupId>com.datagovernance</groupId>
            <artifactId>dg-ai</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <!--
          这里曾经依赖 jjwt（api/impl/jackson 三件套）用于 JWT 校验。
          NFR-SEC-01（docs/23 §4）要求**删除未使用的依赖**：不用的库同样进产物、同样要跟着打补丁，
          是纯粹的供应链负担。当前的令牌校验是静态令牌（AuthProperties），OIDC/JWKS 尚未实现；
          将来真正实现 OIDC 时再按当时的维护状况重新选型（不再默认回到 jjwt）。
        -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.datagovernance.api.DataGovernanceApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
