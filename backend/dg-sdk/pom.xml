<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.datagovernance</groupId>
        <artifactId>dg-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>dg-sdk</artifactId>
    <name>dg-sdk</name>
    <!-- 状态：Java 客户端 + dgctl 已实现；TypeScript/Python 客户端未实现（docs/21 §23） -->
    <description>客户端 SDK：Java 客户端（DgClient）与命令行 dgctl（二者共用同一传输层）。</description>

    <dependencies>
        <dependency>
            <groupId>com.datagovernance</groupId>
            <artifactId>dg-model</artifactId>
        </dependency>
        <!-- 需要 spring-context 才能注册 CapabilityProvider Bean -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- HTTP 传输用 JDK 的 java.net.http；JSON 用 Jackson（与平台同一套序列化） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
