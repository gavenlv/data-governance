# ---------------------------------------------------------------------------
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会提交）
#   cp .env.example .env
#
# 注意：本文件服务于 **Java 控制面**（backend/）。Python 参考实现的变量名不同
# （它用 SQLAlchemy 风格的 DSN），不要把旧变量直接搬过来 —— docs/21 §22 记录过
# 这个坑：`postgresql+psycopg2://` 对 Java 是**非法 JDBC URL**，控制面会起不来。
# ---------------------------------------------------------------------------

# ---- 数据库（真相源，ADR-001）----
# Java 侧必须是 JDBC URL；用户名/密码分开配置（见 application.yml 的 datasource）
DG_DATABASE_URL=jdbc:postgresql://localhost:25011/dg
DG_DATABASE_USER=postgres
DG_DATABASE_PASSWORD=root
# docker compose 内部使用（由 compose 自动注入，此处仅供参考）
# DG_DATABASE_URL=jdbc:postgresql://postgres:5432/dg

# 测试库（pytest 会 TRUNCATE 该库，务必与开发库分开，见 docs/21 §4）
DG_TEST_DATABASE_URL=postgresql+psycopg2://postgres:root@localhost:25011/dg_test

# ---- 命名空间与租户 ----
DG_NAMESPACE=prod
DG_TENANT=default

# ---- 服务 ----
DG_API_PORT=8081

# ---- 认证与授权（docs/09 §9.7、docs/22 Batch 9）----
# static = 静态令牌（仅开发/内网试用）；jwt = 校验企业 OIDC/SSO 签发的 Bearer JWT（生产形态）
# disabled = 不做认证（仅本机开发；生产会启动失败）
DG_AUTH_MODE=static
# 静态令牌（三个内置开发令牌可用 DG_ADMIN_TOKEN / DG_STEWARD_TOKEN / DG_READER_TOKEN 替换）。
# 生产若仍用 static，启动校验会拒绝内置开发令牌与过短令牌，并要求 id 为真实身份。
# DG_ADMIN_TOKEN=请用 openssl rand -base64 32 生成
# DG_STEWARD_TOKEN=...
# DG_READER_TOKEN=...

# ---- JWT / OIDC（DG_AUTH_MODE=jwt 时必填）----
# issuer 必填：不校验签发方的 JWT 等于任何能签 JWT 的系统都能登录
# DG_JWT_ISSUER=https://idp.example.com
# audience 生产必填：多应用共用一个 IdP 时，不校验受众意味着别的系统的令牌可直接调用本平台
# DG_JWT_AUDIENCE=dg-platform
# 公钥来源三选一：
#   DG_JWT_JWKS_URI=https://idp.example.com/.well-known/jwks.json   （常态）
#   DG_JWT_JWKS_FILE=/etc/dg/jwks.json                              （内网 / air-gapped）
#   DG_JWT_JWKS_JSON={"keys":[...]}                                  （单机 / 测试）
# 角色声明（默认 roles；值可为数组，也可为逗号分隔字符串）与姓名声明
# DG_JWT_ROLES_CLAIM=roles
# DG_JWT_NAME_CLAIM=name
# 时钟偏移（秒）与 JWKS 缓存寿命（秒）
# DG_JWT_CLOCK_SKEW_SECONDS=60
# DG_JWT_JWKS_CACHE_SECONDS=300

# ---- 响应安全头（生产基线）----
# HSTS 只应在 TLS 之后开启：单位秒，0 = 不发送（默认）；生产建议 31536000
# DG_SECURITY_HSTS_MAX_AGE=31536000
# CSP 默认为「界面可用的严格策略」；置空字符串可关闭（不建议）
# DG_SECURITY_CONTENT_SECURITY_POLICY=

# ---- 数据源凭据加密（AES-256-GCM）----
# 生成：openssl rand -base64 32；未配置时保存连接会返回 502，绝不明文落库
# DG_SECRET_KEY=

# ---- docker compose 参数 ----
POSTGRES_USER=dg
POSTGRES_PASSWORD=dg_local_password
POSTGRES_DB=dg
POSTGRES_PORT=25432
