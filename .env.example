# ---------------------------------------------------------------------------
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会提交）
#   cp .env.example .env
# ---------------------------------------------------------------------------

# ---- 数据库（真相源，ADR-001）----
# 本机开发（不经 Docker）时指向已有 PostgreSQL
DG_DATABASE_URL=postgresql+psycopg2://postgres:root@localhost:25011/dg
# docker compose 内部使用（由 compose 自动注入，此处仅供参考）
# DG_DATABASE_URL=postgresql+psycopg2://dg:dg_local_password@postgres:5432/dg

# 测试库（pytest 会 TRUNCATE 该库，务必与开发库分开，见 docs/21 §4）
DG_TEST_DATABASE_URL=postgresql+psycopg2://postgres:root@localhost:25011/dg_test

# ---- 命名空间与租户 ----
DG_NAMESPACE=prod
DG_TENANT=default

# ---- 服务 ----
DG_API_HOST=127.0.0.1
DG_API_PORT=8080

# ---- 认证与授权（docs/09 §9.7）----
# static = 静态令牌（开发/内网）；jwt = 校验 Bearer JWT（生产对接 OIDC/SSO）
DG_AUTH_MODE=static
# 自定义静态令牌（JSON 数组）。留空则使用内置开发令牌：
#   dev-admin-token / dev-steward-token / dev-reader-token
# DG_AUTH_TOKENS=[{"token":"change-me","id":"alice@corp","name":"Alice","roles":["ADMIN"],"teams":["platform"]}]

# JWT 模式（DG_AUTH_MODE=jwt 时必填）
# DG_JWT_SECRET=change-me-in-production
# DG_JWT_ALGORITHM=HS256
# DG_JWT_AUDIENCE=
# DG_JWT_ISSUER=
# DG_JWT_ROLES_CLAIM=roles

# ---- docker compose 参数 ----
POSTGRES_USER=dg
POSTGRES_PASSWORD=dg_local_password
POSTGRES_DB=dg
POSTGRES_PORT=25432
